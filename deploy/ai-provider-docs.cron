# Install root-owned mode 0644 as /etc/cron.d/ai-provider-docs.
# Host timezone UTC; stagger from the existing daily catalog jobs.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 */6 * * * root /usr/bin/timeout 600 /usr/bin/flock -n /run/lock/ai-provider-docs.lock /usr/bin/python3 /usr/local/libexec/ai-provider/check_provider_docs.py >> /var/log/ai-provider-docs-check.log 2>&1
